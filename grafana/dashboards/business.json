          "rawSql": "SELECT\n  COALESCE(cat_id, 'unknown') AS cat_id,\n  AVG(fraud_flag::float) AS fraud_rate\nFROM (\n  SELECT cat_id, fraud_flag\n  FROM scores\n  ORDER BY created_at DESC\n  LIMIT 1000\n) recent\nGROUP BY 1\nORDER BY fraud_rate DESC;",
